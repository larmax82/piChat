{
  "$schema": "https://raw.githubusercontent.com/nicegui-io/nicegui/tauri-v2/tauri.conf.json.schema",
  "productName": "piChat",
  "version": "0.1.0",
  "identifier": "com.pichat.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "piChat",
        "width": 1200,
        "height": 800,
        "minWidth": 560,
        "minHeight": 400,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
